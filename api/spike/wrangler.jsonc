{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "c2pa-spike",
  "main": "src/index.js",
  "compatibility_date": "2026-11-24",
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true
    },
    {
      "type": "Text",
      "globs": ["**/*.pem", "**/*.cfg"]
    }
  ]
}
