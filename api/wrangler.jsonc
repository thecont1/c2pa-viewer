{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "c2pa-verify-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-24",
  // agents/mcp/server uses AsyncLocalStorage from node:async_hooks.
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true
    },
    {
      // pem/cfg: vendored trust lists. yaml: api/openapi.yaml is served as
      // text at /v1/openapi.json — the Text rule is what makes it importable.
      "type": "Text",
      "globs": ["**/*.pem", "**/*.cfg", "**/*.yaml"],
      "fallthrough": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "c2pa-verify-api",
      "database_id": "0e4461c8-9386-46f3-84b6-6ab128703f55"
    }
  ],
  "ratelimits": [
    {
      "name": "RATELIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
